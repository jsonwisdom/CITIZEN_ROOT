{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/schemas/TALLY_VERIFIER_PROTOCOL_V0.json",
  "title": "TALLY_VERIFIER_PROTOCOL_V0",
  "type": "object",
  "properties": {
    "version": { "type": "string", "const": "V0" },
    "role": { "type": "string", "const": "Behavioral-completeness checker" },
    "statuses": { "const": ["YES", "NO", "HOLD"] },
    "authority": { "type": "boolean", "const": false },
    "truth_adjudication": { "type": "boolean", "const": false },
    "mark_schema": {
      "$ref": "#/$defs/mark"
    }
  },
  "required": ["version", "role", "statuses", "authority", "truth_adjudication"],
  "additionalProperties": false,
  "$defs": {
    "mark": {
      "type": "object",
      "properties": {
        "rail": { "type": "integer", "minimum": 1, "maximum": 9 },
        "code": {
          "type": "string",
          "enum": ["ASK", "SOURCE", "CHALLENGE", "GAP", "HOLD_CLOSE", "REVERSAL", "DEFENSE", "RECEIPT", "RENDER"]
        },
        "status": { "type": "string", "enum": ["YES", "NO", "HOLD"] },
        "artifact_id": { "type": "string" },
        "source_pointer": { "type": "string" },
        "checked_at": { "type": "string", "format": "date-time" },
        "verifier_id": { "type": "string" },
        "receipt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authority": { "type": "boolean", "const": false }
      },
      "required": ["rail", "code", "status", "artifact_id", "source_pointer", "checked_at", "verifier_id", "receipt_hash", "authority"],
      "additionalProperties": false
    }
  }
}
