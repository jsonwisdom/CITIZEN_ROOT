{
  "schema_id": "CITIZEN_ROOT_CANONICALIZATION_VECTORS_V0_1",
  "protocol_version": "0.1.0",
  "canonicalization": "UTF-8, LF, sorted object keys, no trailing whitespace",
  "hash_algorithm": "SHA-256",
  "authority": false,
  "invariants": [
    "Python canonical bytes == Node canonical bytes for every vector",
    "Python SHA-256 == Node SHA-256 for every vector",
    "No Markdown, Unicode NFC/NFD, prose, or line-wrap normalization",
    "Transformations limited to the locked protocol only"
  ],
  "vectors": [
    {
      "id": "text_crlf_trailing_spaces",
      "format": "text",
      "description": "CRLF line endings + trailing spaces and tabs stripped",
      "input": "hello  \r\nworld\t\r\n",
      "expected_canonical": "hello\nworld\n",
      "expected_sha256": "4a1e67f2fe1d1cc7b31d0ca2ec441da4778203a036a77da10344c85e24ff0f92",
      "expected_size": 12
    },
    {
      "id": "text_bom_utf8",
      "format": "text",
      "description": "UTF-8 BOM stripped",
      "input": "\ufeffalpha\n",
      "expected_canonical": "alpha\n",
      "expected_sha256": "b6a98d9ce9a2d9149288fa3df42d377c3e42737afdcdaf714e33c0a100b51060",
      "expected_size": 6
    },
    {
      "id": "text_empty",
      "format": "text",
      "description": "Empty file stays empty",
      "input": "",
      "expected_canonical": "",
      "expected_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "expected_size": 0
    },
    {
      "id": "text_already_canonical",
      "format": "text",
      "description": "Already-canonical input is identity",
      "input": "line one\nline two\n",
      "expected_canonical": "line one\nline two\n",
      "expected_sha256": "e9024f1a07d29d52ad3aa5e1a18e94db1f3a9fd32b89e39d47c472cd99071e13",
      "expected_size": 18
    },
    {
      "id": "text_no_final_newline",
      "format": "text",
      "description": "Non-empty content without final LF gets exactly one LF",
      "input": "solo",
      "expected_canonical": "solo\n",
      "expected_sha256": "81d6bf3b18d09327c6a7e75c37d3bfb92b4f88807dee37ad2911c08f1690bfbe",
      "expected_size": 5
    },
    {
      "id": "text_trailing_tabs",
      "format": "text",
      "description": "Trailing tabs stripped per line",
      "input": "a\tb\t\nc\t\t\n",
      "expected_canonical": "a\tb\nc\n",
      "expected_sha256": "546614062a18008e08b563073424c00f45c808b93228142eebd3dcf2ac9f63e2",
      "expected_size": 6
    },
    {
      "id": "text_unicode_utf8",
      "format": "text",
      "description": "Unicode UTF-8 preserved (no NFC/NFD normalization)",
      "input": "caf\u00e9 \u65e5\u672c\u8a9e\n",
      "expected_canonical": "caf\u00e9 \u65e5\u672c\u8a9e\n",
      "expected_sha256": "3101ce7f826a453b1300e2c5aa8feada523afb0c46ba7d2d48ac8d4d5ba5411a",
      "expected_size": 16
    },
    {
      "id": "text_markdown_prose",
      "format": "text",
      "description": "Markdown treated as opaque text; internal spaces and structure preserved",
      "input": "# Title\n\n- item one  \n- item two\n\nParagraph with  double spaces.\n",
      "expected_canonical": "# Title\n\n- item one\n- item two\n\nParagraph with  double spaces.\n",
      "expected_sha256": "d46ce671f9dc2be6f57c99268368b5608507017af4e9fd658799c645e6a19486",
      "expected_size": 63
    },
    {
      "id": "text_cr_only",
      "format": "text",
      "description": "Bare CR normalized to LF",
      "input": "one\rtwo\r",
      "expected_canonical": "one\ntwo\n",
      "expected_sha256": "c3f9c8c283a2b1f2f1896f27a01cbe3cddc0c9d93f752e4639035a0f5b36f6e8",
      "expected_size": 8
    },
    {
      "id": "json_key_reorder",
      "format": "json",
      "description": "Object keys sorted; compact form",
      "input": "{\"b\": 2, \"a\": 1}\n",
      "expected_canonical": "{\"a\":1,\"b\":2}\n",
      "expected_sha256": "e8d38819d39f705646bfb643368eca78f7db476c16471dbc33b941b27326410d",
      "expected_size": 14
    },
    {
      "id": "json_pretty_to_compact",
      "format": "json",
      "description": "Pretty-printed JSON collapses to same compact form",
      "input": "{\n  \"a\": 1,\n  \"b\": 2\n}\n",
      "expected_canonical": "{\"a\":1,\"b\":2}\n",
      "expected_sha256": "e8d38819d39f705646bfb643368eca78f7db476c16471dbc33b941b27326410d",
      "expected_size": 14
    },
    {
      "id": "json_nested_keys",
      "format": "json",
      "description": "Nested objects recursively sorted; array order preserved",
      "input": "{\"z\": {\"b\": 1, \"a\": 2}, \"y\": [3, 1]}\n",
      "expected_canonical": "{\"y\":[3,1],\"z\":{\"a\":2,\"b\":1}}\n",
      "expected_sha256": "58dcd960f1663649f054145326450bf06000435ddecf5c9ad58104909bbee02f",
      "expected_size": 30
    },
    {
      "id": "json_escaped_chars",
      "format": "json",
      "description": "Escaped characters round-trip via json.dumps/JSON.stringify",
      "input": "{\"msg\": \"line\\nbreak\\tand\\\"quote\"}\n",
      "expected_canonical": "{\"msg\":\"line\\nbreak\\tand\\\"quote\"}\n",
      "expected_sha256": "50d0d2d6cae1c5d6e80b3801074f9d65dfdde67e9f42b2bf9ed6941a227ea598",
      "expected_size": 34
    },
    {
      "id": "json_empty_object",
      "format": "json",
      "description": "Empty object",
      "input": "{}\n",
      "expected_canonical": "{}\n",
      "expected_sha256": "ca3d163bab055381827226140568f3bef7eaac187cebd76878e0b63e9e442356",
      "expected_size": 3
    },
    {
      "id": "json_empty_array",
      "format": "json",
      "description": "Empty array",
      "input": "[]\n",
      "expected_canonical": "[]\n",
      "expected_sha256": "37517e5f3dc66819f61f5a7bb8ace1921282415f10551d2defa5c3eb0985b570",
      "expected_size": 3
    },
    {
      "id": "json_unicode",
      "format": "json",
      "description": "Unicode in JSON values preserved (ensure_ascii=False)",
      "input": "{\"name\": \"\u65e5\u672c\u8a9e\"}\n",
      "expected_canonical": "{\"name\":\"\u65e5\u672c\u8a9e\"}\n",
      "expected_sha256": "41dcf2359cbeb9bfb4aff621affae8dd0e789ac8ad6b9e156aeaee389b402ba6",
      "expected_size": 21
    },
    {
      "id": "json_already_canonical",
      "format": "json",
      "description": "Already-canonical compact sorted JSON is identity",
      "input": "{\"a\":1,\"b\":2}\n",
      "expected_canonical": "{\"a\":1,\"b\":2}\n",
      "expected_sha256": "e8d38819d39f705646bfb643368eca78f7db476c16471dbc33b941b27326410d",
      "expected_size": 14
    }
  ]
}
