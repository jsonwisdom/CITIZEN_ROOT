      "required":["Q1_first_identity_event","Q2_continuity_years","Q3_creator_object_count","Q4_distinct_counterparties","Q5_repeat_collectors","Q6_activity_streak","Q7_cross_surface_agreement"],
      "properties": {
        "Q1_first_identity_event":{"const":"UNCOMPUTED"},
        "Q2_continuity_years":{"const":"UNCOMPUTED"},
