      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["creator_address","contract_address","token_id","tx_hash","zora_surface_ref"],"properties":{"event_id":true,"event_class":{"const":"ZORA_CREATION_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":true,"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"creator_address":{"type":"string","minLength":1},"contract_address":{"type":"string","minLength":1},"token_id":{"type":["string","integer"]},"tx_hash":{"type":"string","minLength":1},"zora_surface_ref":{"type":"string","minLength":1}}}]
    },
    "zora_export_receipt_event": {
      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["export_timestamp","export_count","pagination_count","export_artifact_hash","query_subject"],"properties":{"event_id":true,"event_class":{"const":"ZORA_EXPORT_RECEIPT_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":{"const":true},"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"export_timestamp":{"type":"string","minLength":1},"export_count":{"type":"integer","minimum":0},"pagination_count":{"type":["integer","null"],"minimum":0},"export_artifact_hash":{"type":["string","null"]},"query_subject":{"type":"string","minLength":1}}}]
    },
    "github_history_event": {
      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["repository","commit_sha","path","observation_type"],"properties":{"event_id":true,"event_class":{"const":"GITHUB_HISTORY_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":true,"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"repository":{"type":"string","minLength":1},"commit_sha":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"observation_type":{"enum":["IDENTITY_REFERENCE","CHAIN_RECEIPT","CREATOR_INDEX","DIRECTORY_ENTRY","EXPORT_RECEIPT","CONTINUITY_RECEIPT"]}}}]
    },
    "conflict_event": {
      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["claim_a_event_id","claim_b_event_id","conflict_type","resolution_status","resolution_receipt_ref"],"properties":{"event_id":true,"event_class":{"const":"CONFLICT_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":true,"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"claim_a_event_id":{"type":"string","minLength":1},"claim_b_event_id":{"type":"string","minLength":1},"conflict_type":{"enum":["ADDRESS_MISMATCH","TIMESTAMP_MISMATCH","COUNT_MISMATCH","IDENTIFIER_MISMATCH","CREATOR_MISMATCH","CHAIN_MISMATCH","SOURCE_DISAGREEMENT"]},"resolution_status":{"enum":["UNRESOLVED","RESOLVED_A","RESOLVED_B","BOTH_VALID_DIFFERENT_SCOPE","SUPERSEDED_BY_LATER_RECEIPT"]},"resolution_receipt_ref":{"type":["string","null"]}}}]
    }
