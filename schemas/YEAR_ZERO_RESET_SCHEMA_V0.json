{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/schemas/YEAR_ZERO_RESET_SCHEMA_V0.json",
  "title": "YEAR_ZERO_RESET_SCHEMA_V0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "V0"
    },
    "authority": {
      "type": "boolean",
      "const": false
    },
    "rails_reference": {
      "$ref": "https://jsonwisdom.github.io/schemas/JASONS_369_RAILS_V0.json"
    },
    "adult_first_term_structure": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "ADULT_FIRST_RIGOR"
        },
        "description": {
          "type": "string"
        }
      },
      "required": ["mode", "description"],
      "additionalProperties": false
    },
    "graduation_rule": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string"
        },
        "enforced": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["condition", "enforced"],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "authority",
    "rails_reference",
    "adult_first_term_structure",
    "graduation_rule"
  ],
  "additionalProperties": false
}
