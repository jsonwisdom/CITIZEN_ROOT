        "conflict_ref":{"type":["string","null"]},
        "authority":{"const":false},
        "identity_equals_legal_person":{"const":false},
        "wrongdoing_inference":{"const":false}
      }
    },
    "identity_event": {
      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["identifier","identifier_type","resolved_to","resolution_type"],"properties":{"event_id":true,"event_class":{"const":"IDENTITY_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":true,"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"identifier":{"type":"string","minLength":1},"identifier_type":{"type":"string","minLength":1},"resolved_to":{"type":["string","null"]},"resolution_type":{"type":"string","minLength":1}}}]
    },
    "base_activity_event": {
      "allOf":[{"$ref":"#/$defs/envelope"},{"type":"object","additionalProperties":false,"required":["chain_id","block_number","tx_hash","address_role","event_signature"],"properties":{"event_id":true,"event_class":{"const":"BASE_ACTIVITY_EVENT"},"timestamp":true,"timestamp_precision":true,"surface":true,"subject_ref":true,"receipt_ref":true,"source_uri":true,"source_hash":true,"observed_value":true,"snapshot":true,"conflict_ref":true,"authority":{"const":false},"identity_equals_legal_person":{"const":false},"wrongdoing_inference":{"const":false},"chain_id":{"const":8453},"block_number":{"type":["integer","null"],"minimum":0},"tx_hash":{"type":"string","minLength":1},"address_role":{"enum":["creator","holder","counterparty","contract","ens","basename","github","portal"]},"event_signature":{"type":["string","null"]}}}]
