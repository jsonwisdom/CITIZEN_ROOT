{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jsonwisdom:jay-onchain-reputation-ledger:v0.1",
  "title": "JAY_ONCHAIN_REPUTATION_LEDGER_V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_version",
    "authority",
    "universal_reputation_score",
    "identity_equals_legal_person",
    "wrongdoing_inference",
    "ingest_status",
    "event_count",
    "events",
    "queries",
    "invariants",
    "surfaces"
  ],
  "properties": {
    "ledger_version": { "const": "0.1" },
    "authority": { "const": false },
    "universal_reputation_score": { "type": "null" },
    "identity_equals_legal_person": { "const": false },
    "wrongdoing_inference": { "const": false },
    "ingest_status": { "const": "NOT_STARTED" },
    "event_count": { "type": "integer", "minimum": 0 },
    "events": { "type": "array" },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Q1_first_identity_event",
        "Q2_continuity_years",
        "Q3_creator_object_count",
        "Q4_distinct_counterparties",
        "Q5_repeat_collectors",
        "Q6_activity_streak",
        "Q7_cross_surface_agreement"
      ],
      "properties": {
        "Q1_first_identity_event": { "const": "UNCOMPUTED" },
        "Q2_continuity_years": { "const": "UNCOMPUTED" },
        "Q3_creator_object_count": { "const": "UNCOMPUTED" },
        "Q4_distinct_counterparties": { "const": "UNCOMPUTED" },
        "Q5_repeat_collectors": { "const": "UNCOMPUTED" },
        "Q6_activity_streak": { "const": "UNCOMPUTED" },
        "Q7_cross_surface_agreement": { "const": "UNCOMPUTED" }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_edge_without_receipt_ref",
        "conflicts_first_class",
        "export_counts_are_snapshots",
        "chronology_is_timestamp_ordered",
        "continuity_only_no_scalar"
      ],
      "properties": {
        "no_edge_without_receipt_ref": { "const": true },
        "conflicts_first_class": { "const": true },
        "export_counts_are_snapshots": { "const": true },
        "chronology_is_timestamp_ordered": { "const": true },
        "continuity_only_no_scalar": { "const": true }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github_write", "live_chain_query", "authority_created"],
      "properties": {
        "github_write": { "type": "boolean" },
        "live_chain_query": { "const": false },
        "authority_created": { "const": false }
      }
    }
  }
}
